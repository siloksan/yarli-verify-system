// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScanResult {
  OK
  WRONG
}

model Component {
  id               String             @id @default(uuid())
  name             String             @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  recipeComponents RecipeComponent[]
  batches          ComponentBatch[]
  fillingActs      FillingActBucket[]
  buckets          Bucket[]
}

model ProductionOrder {
  id          String    @id @default(uuid())
  orderNumber String    @unique
  label       String
  plannedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  status      String    @default("OPEN")

  components  RecipeComponent[]
  scanEvents  ScanEvent[]
  fillingActs FillingActBucket[]

  @@index([orderNumber])
}

model RecipeComponent {
  id            String          @id @default(uuid())
  orderId       String
  componentId   String?
  componentName String
  position      Int
  requiredQty   Decimal         @default(0)
  unit          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  validBatches  String[]
  order         ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  component     Component?      @relation(fields: [componentId], references: [id], onDelete: SetNull)
  scanEvents    ScanEvent[]

  @@index([orderId])
  @@index([componentId])
}

model ComponentBatch {
  id          String    @id @default(uuid())
  componentId String
  batchNumber String    @unique
  barcode     String    @unique
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  component         Component          @relation(fields: [componentId], references: [id])
  scanEvents        ScanEvent[]
  fillingActBuckets FillingActBucket[]

  @@index([componentId])
}

model ScanEvent {
  id          String     @id @default(uuid())
  orderId     String
  componentId String
  batchId     String?
  scannedCode String?
  result      ScanResult
  scannedAt   DateTime   @default(now())
  deviceId    String?
  operatorId  String?
  notes       String?
  bucketId    String?

  order     ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  component RecipeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  batch     ComponentBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  bucket     Bucket? @relation(fields: [bucketId], references: [id], onDelete: SetNull)
  
  @@index([orderId])
  @@index([componentId])
  @@index([batchId])
  @@index([scannedAt])
}

model Bucket {
  id            String             @id @default(uuid())
  componentId   String
  creator       String
  location      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  fillingActs   FillingActBucket[]
  component     Component          @relation(fields: [componentId], references: [id], onDelete: Cascade)
  scanEvents    ScanEvent[]
}

model FillingActBucket {
  id              String   @id @default(uuid())
  workerName      String
  weight          Decimal?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  batchId         String
  bucketId        String
  componentId     String
  orderId         String?
  validBatchesId  String[]

  batch     ComponentBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  bucket    Bucket            @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  component Component         @relation(fields: [componentId], references: [id], onDelete: Restrict)
  order     ProductionOrder?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([bucketId])
  @@index([orderId])
  @@index([batchId])
}
