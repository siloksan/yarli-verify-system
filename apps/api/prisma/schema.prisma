// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScanResult {
  OK
  WRONG
}

model Component {
  id             String           @id @default(uuid())
  name           String           @unique
  batches        ComponentBatch[]
  fillingActs    FillingActBucket[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}


model ProductionOrder {
  id            String            @id @default(uuid())
  orderNumber   String            @unique
  label         String
  plannedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  status        String            @default("OPEN")

  components    RecipeComponent[]
  scanEvents    ScanEvent[]
  fillingActs    FillingActBucket[]
  @@index([orderNumber])
}

model RecipeComponent {
  id              String           @id @default(uuid())
  orderId         String
  componentName   String
  position        Int
  requiredQty     Decimal          @default(0)
  unit            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  validBatches    String[]
  order           ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scanEvents      ScanEvent[]

  @@index([orderId])
}

model ComponentBatch {
  id             String          @id @default(uuid())
  componentId    String
  batchNumber    String          @unique
  barcode        String          @unique
  expiresAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  component      Component  @relation(fields: [componentId], references: [id])
  scanEvents     ScanEvent[]

  @@index([componentId])
}

model ScanEvent {
  id             String           @id @default(uuid())
  orderId        String
  componentId    String
  batchId        String?
  scannedCode    String
  result         ScanResult
  scannedAt      DateTime         @default(now())
  deviceId       String?
  operatorId     String?
  notes          String?

  order          ProductionOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  component      RecipeComponent  @relation(fields: [componentId], references: [id], onDelete: Cascade)
  batch          ComponentBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([componentId])
  @@index([batchId])
  @@index([scannedAt])
}

model Bucket {
  id             String               @id @default(uuid())
  componentName  String
  creator        String
  location       String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  fillingActs    FillingActBucket[]
}

model FillingActBucket {
  id             String               @id @default(uuid())
  componentName  String
  componentBatch String
  workerName     String
  weight         Decimal?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  bucketId       String
  componentId    String
  orderId        String                

  bucket         Bucket               @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  component      Component            @relation(fields: [componentId], references: [id], onDelete: Restrict)
  order          ProductionOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([bucketId])
  @@index([orderId])
  @@index([componentBatch])
}